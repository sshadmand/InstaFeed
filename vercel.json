{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.instafeed.chat"
        }
      ],
      "destination": "https://instafeed.chat/:path*",
      "permanent": true
    }
  ]
}
