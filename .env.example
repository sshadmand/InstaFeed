# Standard Postgres, including Neon. Use a least-privilege database per deployment.
DATABASE_URL=postgresql://instafeed:instafeed@localhost:5432/instafeed
# Public app origin. Required for the standalone server in production; no trailing slash.
APP_URL=http://localhost:3000
PORT=3000
# open: anyone can register/create companies. invite: only invited emails can register;
# new companies are disabled. Bootstrap the first owner with npm run bootstrap-owner.
REGISTRATION_MODE=open
# Optional additional deployment-wide limit on app origins (project origins always apply).
FEEDBACK_ALLOWED_ORIGINS=
# Only for importing pre-upgrade reports into the first project. Remove after import.
FEEDBACK_REVIEW_TOKEN=
# PUBLIC project key for the homepage/playground widget. Set at build time.
# Match DEMO_PROJECT_KEY to accept and discard demo payloads, or use a real project key to store them.
VITE_DEMO_PROJECT_KEY=
# Standalone server: true only behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false

# Dedicated public key for the server-side discard-only demo route.
DEMO_PROJECT_KEY=
# Private signing secret (32+ random characters) for short-lived demo comment receipts.
DEMO_TOKEN_SECRET=
